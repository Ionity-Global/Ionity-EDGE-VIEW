<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="StationPicoInstaller.ControlPage"
             BackgroundColor="#1a1a2e">

    <ScrollView>
        <VerticalStackLayout Padding="30,20" Spacing="12">

            <Label Text="🎛️ Device Control"
                   FontSize="28" FontAttributes="Bold"
                   TextColor="#e94560" HorizontalOptions="Center" />
            <Label Text="IO-nity EDGE-VIEW · live over WiFi (TCP 4242)"
                   FontSize="14" TextColor="#888" HorizontalOptions="Center" />

            <BoxView HeightRequest="1" Color="#333" Margin="0,5" />

            <!-- Device -->
            <Frame BackgroundColor="#16213e" CornerRadius="8" Padding="15" BorderColor="#0f3460">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Device" FontSize="16" FontAttributes="Bold" TextColor="#e94560" />
                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                        <Entry Grid.Column="0" x:Name="IpEntry" Placeholder="Device IP (e.g. 192.168.1.100)"
                               PlaceholderColor="#666" TextColor="#eee" BackgroundColor="#0f3460" />
                        <Button Grid.Column="1" x:Name="PingBtn" Text="📡 Ping" Clicked="OnPingClicked"
                                BackgroundColor="#0f3460" TextColor="#eee" />
                        <Button Grid.Column="2" x:Name="SaveIpBtn" Text="💾 Save" Clicked="OnSaveIpClicked"
                                BackgroundColor="#0f3460" TextColor="#eee" />
                    </Grid>
                    <Label x:Name="DeviceStatus" Text="Waiting for discovery beacon (UDP 4243)..."
                           TextColor="#888" FontSize="12" />
                </VerticalStackLayout>
            </Frame>

            <!-- Web bridge -->
            <Frame BackgroundColor="#16213e" CornerRadius="8" Padding="15" BorderColor="#00bcd4">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Web Console Bridge" FontSize="16" FontAttributes="Bold" TextColor="#00bcd4" />
                    <Label Text="Lets the EDGE-VIEW web console on GitHub Pages drive this machine's link to the device. Paste the pairing token into the web console once."
                           FontSize="12" TextColor="#888" />
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                        <Switch Grid.Column="0" x:Name="BridgeSwitch" Toggled="OnBridgeToggled"
                                OnColor="#00bcd4" ThumbColor="#eee" />
                        <Label Grid.Column="1" x:Name="BridgeStatus" Text="Bridge off"
                               TextColor="#888" FontSize="12" VerticalOptions="Center" />
                        <Button Grid.Column="2" Text="🔑 Copy token" Clicked="OnCopyTokenClicked"
                                BackgroundColor="#0f3460" TextColor="#eee" />
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <Entry Grid.Column="0" x:Name="TokenEntry" IsReadOnly="True" FontFamily="Consolas"
                               TextColor="#00bcd4" BackgroundColor="#0f3460" />
                        <Button Grid.Column="1" Text="♻ New token" Clicked="OnNewTokenClicked"
                                BackgroundColor="#0f3460" TextColor="#eee" />
                    </Grid>
                    <Button Text="🌐 Open web console" Clicked="OnOpenConsoleClicked"
                            BackgroundColor="#00bcd4" TextColor="#0a0a0f" FontAttributes="Bold" />
                </VerticalStackLayout>
            </Frame>

            <!-- Game mode -->
            <Frame BackgroundColor="#16213e" CornerRadius="8" Padding="15" BorderColor="#0f3460">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Screen Game (attract AI)" FontSize="16" FontAttributes="Bold" TextColor="#e94560" />
                    <Label Text="The on-device AI plays this in the centre stage."
                           FontSize="12" TextColor="#888" />
                    <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="8">
                        <Button Grid.Column="0" Text="🟡 Pac-Man" Clicked="OnModePacmanClicked"
                                BackgroundColor="#e94560" TextColor="White" FontAttributes="Bold" />
                        <Button Grid.Column="1" Text="🐍 Snake" Clicked="OnModeSnakeClicked"
                                BackgroundColor="#0f3460" TextColor="#eee" />
                        <Button Grid.Column="2" Text="🎾 Bounce" Clicked="OnModeBounceClicked"
                                BackgroundColor="#0f3460" TextColor="#eee" />
                        <Button Grid.Column="3" Text="⬛ Off" Clicked="OnModeOffClicked"
                                BackgroundColor="#0f3460" TextColor="#eee" />
                    </Grid>
                </VerticalStackLayout>
            </Frame>

            <!-- Quick actions -->
            <Frame BackgroundColor="#16213e" CornerRadius="8" Padding="15" BorderColor="#0f3460">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Quick Actions" FontSize="16" FontAttributes="Bold" TextColor="#e94560" />
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                        <Button Grid.Column="0" Text="⏰ Sync Time Now" Clicked="OnSyncTimeClicked"
                                BackgroundColor="#0f3460" TextColor="#eee" />
                        <Button Grid.Column="1" Text="🔄 Reboot Device" Clicked="OnRebootClicked"
                                BackgroundColor="#7a1f2b" TextColor="#eee" />
                    </Grid>
                </VerticalStackLayout>
            </Frame>

            <!-- Log -->
            <Frame BackgroundColor="#0a0a0f" CornerRadius="8" Padding="10" BorderColor="#0f3460">
                <ScrollView HeightRequest="180" x:Name="LogScroll">
                    <Label x:Name="LogLabel" Text="" TextColor="#44ff44"
                           FontFamily="Consolas" FontSize="12" LineBreakMode="WordWrap" />
                </ScrollView>
            </Frame>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
