<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="StationPicoInstaller.MessagesPage"
             BackgroundColor="#1a1a2e">

    <ScrollView>
        <VerticalStackLayout Padding="30,20" Spacing="12">

            <Label Text="💬 Broadcast Messages"
                   FontSize="28" FontAttributes="Bold"
                   TextColor="#e94560" HorizontalOptions="Center" />
            <Label Text="Posted to the screen marquee over WiFi (HTTP port 80)"
                   FontSize="14" TextColor="#888" HorizontalOptions="Center" />

            <BoxView HeightRequest="1" Color="#333" Margin="0,5" />

            <!-- Compose -->
            <Frame BackgroundColor="#16213e" CornerRadius="8" Padding="15" BorderColor="#0f3460">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Compose" FontSize="16" FontAttributes="Bold" TextColor="#e94560" />
                    <Entry x:Name="AuthorEntry" Placeholder="Your name" MaxLength="30"
                           PlaceholderColor="#666" TextColor="#eee" BackgroundColor="#0f3460" />
                    <Editor x:Name="TextEditor" Placeholder="Message to display on the screen"
                            MaxLength="250" HeightRequest="90"
                            PlaceholderColor="#666" TextColor="#eee" BackgroundColor="#0f3460" />
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                        <Button Grid.Column="0" x:Name="SendBtn" Text="📤 Send to Screen" Clicked="OnSendClicked"
                                BackgroundColor="#e94560" TextColor="White" FontAttributes="Bold" />
                        <Button Grid.Column="1" x:Name="RefreshBtn" Text="🔄 Refresh List" Clicked="OnRefreshClicked"
                                BackgroundColor="#0f3460" TextColor="#eee" />
                    </Grid>
                    <Label x:Name="SendStatus" Text="" FontSize="12" TextColor="#888" />
                </VerticalStackLayout>
            </Frame>

            <!-- Share -->
            <Frame BackgroundColor="#16213e" CornerRadius="8" Padding="15" BorderColor="#0f3460">
                <VerticalStackLayout Spacing="6">
                    <Label Text="Share with anyone on this WiFi" FontSize="16" FontAttributes="Bold" TextColor="#e94560" />
                    <Label Text="Any phone or laptop on the same network can post to the screen — the device also shows this as a QR code."
                           FontSize="12" TextColor="#888" />
                    <Label x:Name="ShareUrlLabel" Text="http://—/" FontSize="18"
                           FontAttributes="Bold" TextColor="#00bcd4" />
                    <Button x:Name="CopyUrlBtn" Text="📋 Copy Link" Clicked="OnCopyUrlClicked"
                            BackgroundColor="#0f3460" TextColor="#eee" HorizontalOptions="Start" />
                </VerticalStackLayout>
            </Frame>

            <!-- Recent -->
            <Frame BackgroundColor="#0a0a0f" CornerRadius="8" Padding="10" BorderColor="#0f3460">
                <VerticalStackLayout Spacing="6">
                    <Label Text="Recent on device" FontSize="14" FontAttributes="Bold" TextColor="#e94560" />
                    <Label x:Name="MessagesLabel" Text="No messages loaded." TextColor="#44ff44"
                           FontFamily="Consolas" FontSize="12" LineBreakMode="WordWrap" />
                </VerticalStackLayout>
            </Frame>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
